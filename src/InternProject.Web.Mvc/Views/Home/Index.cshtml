@using InternProject.Web.Startup
@{
    ViewBag.Title = L("HomePage");
    ViewBag.CurrentPageName = PageNames.Home;
}

@section scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/view-resources/Views/Home/Index.js" asp-append-version="true"></script>
}

<style>
    .info-box {
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border-radius: 8px;
        border: 1px solid rgba(0,0,0,0.03);
        transition: all 0.2s ease;
    }
    .info-box:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 12px rgba(0,0,0,0.08);
    }
    .badge-status-completed {
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 9999px;
        font-size: 0.75rem;
    }
    .badge-status-cancelled {
        background-color: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 9999px;
        font-size: 0.75rem;
    }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-12">
                <h1 class="m-0 font-weight-bold text-dark">
                <!-- <i class="fas fa-home mr-2 text-indigo"> -->
                </i> @L("HomePage")</h1>
            </div>
        </div>
    </div>
</div>

<section class="content text-dark">
<div class="container-fluid">
<div class="row">
    <div class="col-12">
        <!-- <div class="alert alert-indigo alert-dismissible bg-indigo text-white border-0 shadow-sm" style="border-radius: 10px;">
            <!-- <h6><i class="icon fas fa-store mr-2"></i> Chào mừng bạn đến với hệ thống Quản lý Cửa hàng Tạp hóa! Dưới đây là thống kê nhanh về tình hình hoạt động hôm nay.</h6> -->
        <!-- </div> -->
    </div>
</div>

<!-- Info boxes -->
<div class="row">
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box">
            <span class="info-box-icon bg-info elevation-1">
                <i class="fas fa-shopping-cart"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text font-weight-bold text-muted text-xs text-uppercase">@L("TodayRevenue")</span>
                <span class="info-box-number text-lg font-weight-bold" id="today-revenue">0 đ</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box mb-3">
            <span class="info-box-icon bg-success elevation-1">
                <i class="fas fa-hand-holding-usd"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text font-weight-bold text-muted text-xs text-uppercase">@L("TodayProfit")</span>
                <span class="info-box-number text-lg font-weight-bold" id="today-profit">0 đ</span>
            </div>
        </div>
    </div>
    
    <div class="clearfix hidden-md-up"></div>

    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box mb-3">
            <span class="info-box-icon bg-primary elevation-1">
                <i class="fas fa-file-invoice-dollar"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text font-weight-bold text-muted text-xs text-uppercase">@L("TodayInvoices")</span>
                <span class="info-box-number text-lg font-weight-bold" id="today-invoices">0</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box mb-3">
            <span class="info-box-icon bg-danger elevation-1">
                <i class="fas fa-exclamation-circle"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text font-weight-bold text-muted text-xs text-uppercase">@L("OutOfStockAlert")</span>
                <span class="info-box-number text-lg font-weight-bold" id="outofstock-count">0</span>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card card-outline card-indigo shadow-sm" style="border-radius: 10px;">
            <div class="card-header border-0 bg-transparent">
                <h5 class="card-title font-weight-bold text-dark"><i class="fas fa-chart-area mr-2 text-indigo"></i> @L("RevenueProfitGrowthLast6Months")</h5>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="chart">
                            <!-- Sales Chart Canvas -->
                            <canvas id="salesChart" height="220" style="height: 220px; display: block; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left col -->
    <div class="col-md-8">
        <!-- TABLE: LATEST ORDERS -->
        <div class="card card-outline card-indigo shadow-sm" style="border-radius: 10px;">
            <div class="card-header border-0 bg-transparent d-flex justify-content-between align-items-center">
                <h5 class="card-title font-weight-bold text-dark"><i class="fas fa-receipt mr-2 text-indigo"></i> @L("RecentInvoices")</h5>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-striped text-nowrap m-0 align-middle" id="recentInvoicesTable">
                    <thead>
                    <tr>
                        <th>@L("InvoiceNumber")</th>
                        <th>@L("Customer")</th>
                        <th>@L("TotalAmount")</th>
                        <th>@L("InvoiceDate")</th>
                        <th>@L("InvoiceStatus")</th>
                    </tr>
                    </thead>
                    <tbody id="recent-invoices-tbody">
                        <tr>
                            <td colspan="5" class="text-center p-3 text-muted">@L("LoadingData")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer border-0 bg-transparent clearfix d-flex justify-content-between">
                <a href="/Invoices/Create" class="btn btn-sm btn-indigo rounded-lg px-3"><i class="fas fa-plus mr-1"></i> @L("POS")</a>
                <a href="/Invoices" class="btn btn-sm btn-secondary rounded-lg px-3">@L("ViewAllInvoices") <i class="fas fa-arrow-right ml-1"></i></a>
            </div>
        </div>
    </div>
    
    <!-- Right col -->
    <div class="col-md-4">
        <!-- Info Boxes Style 2 -->
        <div class="info-box mb-3 bg-warning text-white">
            <span class="info-box-icon"><i class="fas fa-exclamation-triangle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text text-uppercase text-xs font-weight-bold opacity-8">@L("LowStockProducts")</span>
                <span class="info-box-number text-lg font-weight-bold" id="lowstock-count">0</span>
            </div>
        </div>
        <div class="info-box mb-3 bg-indigo text-white">
            <span class="info-box-icon"><i class="fas fa-chart-line"></i></span>
            <div class="info-box-content">
                <span class="info-box-text text-uppercase text-xs font-weight-bold opacity-8">@L("ViewDetailedReports")</span>
                <a href="/Reports" class="text-white font-weight-bold mt-1 d-block text-sm">@L("GoToReportsPage") <i class="fas fa-chevron-right ml-1"></i></a>
            </div>
        </div>
    </div>
</div>
</div>
</section>
