@using InternProject.Web.Startup
@using InternProject.Grocery
@{
    ViewBag.Title = L("InventoryLogs");
    ViewBag.CurrentPageName = PageNames.InventoryLogs;
}
@section scripts
{
    <environment names="Development">
        <script src="~/view-resources/Views/InventoryLogs/Index.js" asp-append-version="true"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="~/view-resources/Views/InventoryLogs/Index.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="content-header py-3">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="m-0"><b>@L("InventoryLogs")</b></h1>
            @* <span class="text-muted">@L("InventoryLogsSubtitle")</span> *@
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <form id="InventoryLogsSearchForm" class="row g-2 mb-3">
                    <div class="col-md-3">
                        <input type="text" name="Keyword" class="form-control" placeholder="@L("SearchInventoryLogsPlaceholder")" />
                    </div>
                    <div class="col-md-3">
                        <select name="ProductId" class="form-control">
                            <option value="">@L("AllProductsSelect")</option>
                            @foreach (var product in ViewBag.Products)
                            {
                                <option value="@product.Id">@product.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="Type" class="form-control">
                            <option value="">@L("AllInventoryLogTypes")</option>
                            <option value="@((int)InventoryLogType.Import)">@L("InventoryLogImport")</option>
                            <option value="@((int)InventoryLogType.Export)">@L("InventoryLogExport")</option>
                            <option value="@((int)InventoryLogType.Dispose)">@L("InventoryLogDispose")</option>
                            <option value="@((int)InventoryLogType.Adjust)">@L("InventoryLogAdjust")</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="FromDate" class="form-control" aria-label="@L("FromDate")" />
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="ToDate" class="form-control" aria-label="@L("ToDate")" />
                    </div>
                </form>

                <div class="table-responsive">
                    <table id="InventoryLogsTable" class="table table-striped table-bordered w-100">
                        <thead>
                            <tr>
                                <th>@L("InventoryLogDate")</th>
                                <th>@L("Product")</th>
                                <th>@L("InventoryLogType")</th>
                                <th>@L("Quantity")</th>
                                <th>@L("RemainingQuantity")</th>
                                <th>@L("BatchCode")</th>
                                <th>@L("Creator")</th>
                                <th>@L("ReferenceDocument")</th>
                                <th>@L("Note")</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
